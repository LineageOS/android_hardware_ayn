    <string name="calibration_title">Kalibrering av tommelspakar</string>
    <string name="calibration_intro_description">Denne vegvisaren kalibrerer dei analoge tommelspakane dine:\n\n1. Midtstilling – lat båe spakane stå urørde\n2–3. Rekkjevidd – drei kvar spak heilt rundt i ring\n4–5. Dødsone – dra og slepp kvar spak fleire gonger\n\nDu kjem automatisk vidare så snart nok data er samla inn.</string>
    <string name="calibration_start">Start</string>
    <string name="calibration_cancel">Avbryt</string>
    <string name="calibration_phase_center_title">Steg 1: Midtstilling</string>
    <string name="calibration_phase_center_desc">Lat båe spakane stå urørde i midten. «Neste» kjem til syne når målingane er stabile.</string>
    <string name="calibration_phase_range_left_title">Steg 2: Rekkjevidd for venstre spak</string>
    <string name="calibration_phase_range_left_desc">Drei venstre spak sakte heilt rundt i ring og ut i alle kantar. «Neste» kjem til syne når heile rekkjevidda er registrert.</string>
    <string name="calibration_phase_range_right_title">Steg 3: Rekkjevidd for høgre spak</string>
    <string name="calibration_phase_range_right_desc">Drei høgre spak sakte heilt rundt i ring og ut i alle kantar. «Neste» kjem til syne når heile rekkjevidda er registrert.</string>
    <string name="calibration_phase_deadzone_left_title">Steg 4: Daudsone for venstre spak</string>
    <string name="calibration_phase_deadzone_left_desc">Dra venstre spak heilt ut til kanten og slepp han. Gjenta minst 3 gonger frå ulike kantar. «Neste» kjem til syne når nok data er samla inn.</string>
    <string name="calibration_phase_deadzone_right_title">Steg 5: Daudsone for høgre spak</string>
    <string name="calibration_phase_deadzone_right_desc">Dra høgre spak heilt ut til kanten og slepp han. Gjenta minst 3 gonger frå ulike kantar. «Neste» kjem til syne når nok data er samla inn.</string>
    <string name="calibration_next">Neste</string>
    <string name="calibration_accept">Godkjenn</string>
    <string name="calibration_retry">Prøv på nytt</string>
    <string name="calibration_test_title">Test kalibreringa</string>
    <string name="calibration_test_desc">Samanlikn før og etter. Dei kalibrerte spakane skal gå fint tilbake til midten og nå heilt ut til alle kantar.</string>
    <string name="calibration_test_before">Før (rådata)</string>
