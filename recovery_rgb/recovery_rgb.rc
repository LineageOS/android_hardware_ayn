service recovery.rgb /system/bin/recovery_rgb ${init.svc.fastbootd}
    class main
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery_rgb:s0

on property:init.svc.fastbootd=*
    start recovery.rgb
